local espNesneler = {} -- [UserId] = Highlight

local function espKaldir(userId)
	local h = espNesneler[userId]
	if h then
		h:Destroy()
		espNesneler[userId] = nil
	end
end

local function espYenile()
	local kendiKarakter = LocalPlayer.Character
	local kendiRoot = kendiKarakter and koku(kendiKarakter)

	-- Secili olmayanlarin highlight'ini sil
	for userId in pairs(espNesneler) do
		if not secililer[userId] then espKaldir(userId) end
	end

	for userId in pairs(secililer) do
		local oyuncu = oyuncular[userId]
		local char = oyuncu and oyuncu.Character
		local root = char and koku(char)

		local goster = ESP.Aktif and root and kendiRoot
			and (root.Position - kendiRoot.Position).Magnitude <= ESP.Mesafe

		local h = espNesneler[userId]
		if goster then
			if not h or h.Adornee ~= char or not h.Parent then
				if h then h:Destroy() end
				h = Instance.new("Highlight")
				h.Name = "H" .. userId
				h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				h.Adornee = char
				h.Parent = espKlasor
				espNesneler[userId] = h
			end
			h.FillColor = ESP.Fill
			h.OutlineColor = ESP.Outline
			h.FillTransparency = ESP.FillSaydam
			h.OutlineTransparency = ESP.OutlineSaydam
		elseif h then
			espKaldir(userId)
		end
	end
end

local espSayac = 0
RunService.Heartbeat:Connect(function(dt)
	espSayac += dt
	if espSayac < 0.1 then return end
	espSayac = 0
	espYenile()
end)

