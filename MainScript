	-------------------------------------------------------------
	-- Kucult / GUI tusu / surukleme
	-------------------------------------------------------------
	local kucuk = false
	kucult.MouseButton1Click:Connect(function()
		kucuk = not kucuk
		icerik.Visible = not kucuk
		sekmeBar.Visible = not kucuk
		ana.Size = kucuk and UDim2.fromOffset(GENISLIK, 38) or UDim2.fromOffset(GENISLIK, YUKSEKLIK)
		kucult.Text = kucuk and "+" or "-"
	end)

	UserInputService.InputBegan:Connect(function(input, yaziyor)
		if yaziyor then return end
		if input.KeyCode == GUI_TUSU then
			gui.Enabled = not gui.Enabled
		end
	end)

	local suruklenuyor, baslangicInput, baslangicPoz
	baslik.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			suruklenuyor = true
			baslangicInput = input.Position
			baslangicPoz = ana.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					suruklenuyor = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if suruklenuyor and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local fark = input.Position - baslangicInput
			ana.Position = UDim2.new(
				baslangicPoz.X.Scale, baslangicPoz.X.Offset + fark.X,
				baslangicPoz.Y.Scale, baslangicPoz.Y.Offset + fark.Y
			)
		end
	end)
