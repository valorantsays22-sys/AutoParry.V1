	local function slider(parent, baslikYazisi, min, max, baslangic, birim, cb)
		local kap = yap("Frame", {
			Size = UDim2.new(1, 0, 0, 38),
			BackgroundTransparency = 1,
			LayoutOrder = sn(),
		}, parent)

		local yazi = etiket(kap, "", 12, C.yazi)
		yazi.Size = UDim2.new(1, 0, 0, 18)

		local ray = yap("Frame", {
			Size = UDim2.new(1, -8, 0, 6),
			Position = UDim2.fromOffset(4, 26),
			BackgroundColor3 = C.ray,
			BorderSizePixel = 0,
		}, kap)
		yuvarla(ray, 3)

		local dolu = yap("Frame", {
			Size = UDim2.new(0, 0, 1, 0),
			BackgroundColor3 = C.vurgu,
			BorderSizePixel = 0,
		}, ray)
		yuvarla(dolu, 3)

		local topuz = yap("Frame", {
			Size = UDim2.fromOffset(14, 14),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
		}, ray)
		yuvarla(topuz, 7)

		local function ayarla(v, bildir)
			v = math.clamp(math.floor(v + 0.5), min, max)
			local oran = (v - min) / (max - min)
			dolu.Size = UDim2.new(oran, 0, 1, 0)
			topuz.Position = UDim2.new(oran, 0, 0.5, 0)
			yazi.Text = baslikYazisi .. ": " .. v .. (birim or "")
			if bildir then cb(v) end
		end
		ayarla(baslangic, false)

		local suruklenuyor = false
		local function girdi(x)
			local oran = math.clamp((x - ray.AbsolutePosition.X) / math.max(1, ray.AbsoluteSize.X), 0, 1)
			ayarla(min + (max - min) * oran, true)
		end

		kap.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1
				or i.UserInputType == Enum.UserInputType.Touch then
				suruklenuyor = true
				girdi(i.Position.X)
			end
		end)
		UserInputService.InputChanged:Connect(function(i)
			if suruklenuyor and (i.UserInputType == Enum.UserInputType.MouseMovement
				or i.UserInputType == Enum.UserInputType.Touch) then
				girdi(i.Position.X)
			end
		end)
		UserInputService.InputEnded:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1
				or i.UserInputType == Enum.UserInputType.Touch then
				suruklenuyor = false
			end
		end)

		return ayarla
	end

