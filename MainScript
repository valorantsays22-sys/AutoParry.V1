		for userId in pairs(canBarlari) do canBarKaldir(userId) end
		return
	end

	-- Oyundan cikanlarin barini sil
	for userId in pairs(canBarlari) do
		if not Players:GetPlayerByUserId(userId) then canBarKaldir(userId) end
	end

	for _, oyuncu in ipairs(Players:GetPlayers()) do
		if oyuncu ~= LocalPlayer then
			local userId = oyuncu.UserId
			local char = oyuncu.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")

			local hedef = char and (char:FindFirstChild("Head") or koku(char))

			-- Uzaktaki oyuncu henuz yuklenmediyse (StreamingEnabled) hedef nil olur;
			-- yaklasinca yuklenir ve bar otomatik olusur.
			if hum and hum.Health > 0 and hedef and char:IsDescendantOf(workspace) then
				local o = canBarlari[userId]
				if not o or o.char ~= char or not o.gui.Parent then
					canBarKaldir(userId)
					o = canBarOlustur(char)
					canBarlari[userId] = o
				end
				if o.gui.Adornee ~= hedef then
					o.gui.Adornee = hedef
				end

				-- Can (toggle'a gore goster/gizle)
				o.zemin.Visible = MISC.EnemyHealth
				o.yazi.Visible = MISC.EnemyHealth
				if MISC.EnemyHealth then
					local oran = math.clamp(hum.Health / math.max(1, hum.MaxHealth), 0, 1)
					o.dolu.Size = UDim2.new(oran, 0, 1, 0)
					o.dolu.BackgroundColor3 = Color3.fromRGB(255, 60, 60):Lerp(Color3.fromRGB(60, 255, 100), oran)
					o.yazi.Text = math.floor(hum.Health + 0.5) .. " / " .. math.floor(hum.MaxHealth + 0.5)
				end

				-- Hunger
				o.hZemin.Visible = MISC.EnemyHunger
				-- Sadece hunger aciksa bar yukari kaysin
				o.hZemin.Position = MISC.EnemyHealth and UDim2.fromOffset(0, 24) or UDim2.fromOffset(0, 12)
				if MISC.EnemyHunger then
					if not o.kaynak and os.clock() - o.sonAra > 1 then
						o.sonAra = os.clock()
						o.kaynak = hungerKaynakBul(oyuncu, char)
					end

					if o.kaynak then
						local ok, v, mx = pcall(o.kaynak)
						if ok and type(v) == "number" then
							mx = (type(mx) == "number" and mx > 0) and mx or 100
							local oran = math.clamp(v / mx, 0, 1)
							o.hDolu.Size = UDim2.new(oran, 0, 1, 0)
							o.hYazi.Text = "Hunger " .. math.floor(v + 0.5)
						else
							o.kaynak = nil
						end
					else
						o.hDolu.Size = UDim2.new(0, 0, 1, 0)
						o.hYazi.Text = "Hunger ?"
					end
				end
			else
				canBarKaldir(userId)
			end
		end
	end
end

