	-------------------------------------------------------------
	-- SEKME: Heavy Attack (windup on selected players' models)
	-------------------------------------------------------------
	local function bilgi(parent, yazi)
		local l = etiket(parent, yazi, 11, C.gri)
		l.Size = UDim2.new(1, 0, 0, 30)
		l.TextWrapped = true
		l.TextYAlignment = Enum.TextYAlignment.Top
		l.LayoutOrder = sn()
		return l
	end

	local function restoreButonu(parent, fn)
		local b = yap("TextButton", {
			Size = UDim2.new(1, 0, 0, 34),
			BackgroundColor3 = C.vurgu,
			Text = "Restore Settings",
			TextColor3 = Color3.new(1, 1, 1),
			Font = Enum.Font.GothamBold,
			TextSize = 13,
			BorderSizePixel = 0,
			AutoButtonColor = true,
			LayoutOrder = sn(),
		}, parent)
		yuvarla(b, 6)
		b.MouseButton1Click:Connect(fn)
		return b
	end

	local heavySayfa = kaydirmaSayfasi("Heavy Attack")

	bilgi(heavySayfa, "Detects the heavy attack of the players selected in the Players tab.")

	local setHeavyAktif = toggle(heavySayfa, "Heavy Attack Detection", HEAVY.Aktif, function(v)
		HEAVY.Aktif = v
	end)

	local setHeavyMesafe = slider(heavySayfa, "Detection Distance", 5, 100, HEAVY.Mesafe, " stud", function(v)
		HEAVY.Mesafe = v
	end)

	local setHeavyTepki = slider(heavySayfa, "Reaction Time", 0, 500, math.floor(HEAVY.Tepki * 1000 + 0.5), " ms", function(v)
		HEAVY.Tepki = v / 1000
	end)

	local setDebug = toggle(heavySayfa, "Debug (F9 console)", DEBUG, function(v)
		DEBUG = v
	end)

	restoreButonu(heavySayfa, function()
		setHeavyAktif(VARSAYILAN.Heavy.Aktif, true)
		setHeavyMesafe(VARSAYILAN.Heavy.Mesafe, true)
		setHeavyTepki(math.floor(VARSAYILAN.Heavy.Tepki * 1000 + 0.5), true)
		setDebug(VARSAYILAN.Debug, true)
	end)

