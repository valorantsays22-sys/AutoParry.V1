-- Hunger degerini Player / Character / Humanoid uzerinde arar (Attribute veya NumberValue/IntValue)
local function hungerKaynakBul(oyuncu, char)
	local adaylar = { oyuncu, char, char and char:FindFirstChildOfClass("Humanoid") }
	for _, obj in ipairs(adaylar) do
		for _, isim in ipairs(HUNGER_ISIMLERI) do
			if type(obj:GetAttribute(isim)) == "number" then
				return function()
					if not obj:IsDescendantOf(game) then return nil end
					return obj:GetAttribute(isim), obj:GetAttribute("Max" .. isim)
				end
			end
		end
		for _, d in ipairs(obj:GetDescendants()) do
			if (d:IsA("NumberValue") or d:IsA("IntValue")) and string.lower(d.Name) == "hunger" then
				local mx = obj:FindFirstChild("MaxHunger", true)
				return function()
					if not d:IsDescendantOf(game) then return nil end
					return d.Value, (mx and mx:IsDescendantOf(game)) and mx.Value or nil
				end
			end
		end
	end
	return nil
end

