-- Tespit sistemi (olay tabanli, sadece secili oyuncular izlenir)
---------------------------------------------------------------------
local takip = {}

local function koku(karakter)
	return karakter:FindFirstChild("HumanoidRootPart")
		or karakter:FindFirstChild("Torso")
		or karakter:FindFirstChild("UpperTorso")
		or karakter.PrimaryPart
end

local function nesneUygun(karakter, d)
	return string.find(string.lower(d.Name), aranacak, 1, true) ~= nil
end

local function baglantilariKes(liste_)
	for _, c in ipairs(liste_) do c:Disconnect() end
	table.clear(liste_)
end

local function karakterTemizle(veri)
	baglantilariKes(veri.karakterBag)
	table.clear(veri.aktif)
	veri.karakter = nil
end

local function karakterBagla(veri, oyuncu, karakter)
	karakterTemizle(veri)
	veri.karakter = karakter

	local function ekle(d)
		if nesneUygun(karakter, d) then
			veri.aktif[d] = true
			log(oyuncu.Name, "Heavy Attack Used:")
		end
	end

	table.insert(veri.karakterBag, karakter.DescendantAdded:Connect(ekle))
	table.insert(veri.karakterBag, karakter.DescendantRemoving:Connect(function(d)
		veri.aktif[d] = nil
	end))

	for _, d in ipairs(karakter:GetDescendants()) do
		ekle(d)
	end
end

local function takibiBaslat(oyuncu)
	if takip[oyuncu.UserId] then return end

	local veri = { aktif = {}, karakter = nil, karakterBag = {}, oyuncuBag = {} }
	takip[oyuncu.UserId] = veri

	table.insert(veri.oyuncuBag, oyuncu.CharacterAdded:Connect(function(karakter)
		karakterBagla(veri, oyuncu, karakter)
	end))
	table.insert(veri.oyuncuBag, oyuncu.CharacterRemoving:Connect(function()
		karakterTemizle(veri)
	end))

	if oyuncu.Character then
		karakterBagla(veri, oyuncu, oyuncu.Character)
	end
end

local function takibiDurdur(userId)
	local veri = takip[userId]
	if not veri then return end
	karakterTemizle(veri)
	baglantilariKes(veri.oyuncuBag)
	takip[userId] = nil
end

local function fBas(tepkiSuresi)
	islemde = true

	local ok, hata = pcall(function()
		task.wait(math.max(0, tepkiSuresi))
		VirtualInputManager:SendKeyEvent(true, TUS, false, game)
		task.wait(BASILI_TUTMA)
	end)

	pcall(function()
		VirtualInputManager:SendKeyEvent(false, TUS, false, game)
	end)

	if not ok then log("Error:", hata) end

	task.wait(BITIS_BEKLEME)
	islemde = false
end

RunService.Heartbeat:Connect(function()
	if islemde then return end
	if not HEAVY.Aktif then return end
	if next(takip) == nil then return end

	local kendiKarakter = LocalPlayer.Character
	local kendiRoot = kendiKarakter and koku(kendiKarakter)
	if not kendiRoot then return end

	for _, veri in pairs(takip) do
		if veri.karakter and next(veri.aktif) ~= nil then
			local root = koku(veri.karakter)
			if root and (root.Position - kendiRoot.Position).Magnitude <= HEAVY.Mesafe then
				task.spawn(fBas, HEAVY.Tepki)
				break
			end
		end
	end
end)

