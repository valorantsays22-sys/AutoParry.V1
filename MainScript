-- Dondurur: izinli_mi, plan ("permanent"/"week"/"month"/"expired"/"invalid"/"none"), kalan_saniye
local function whitelistDurumu(userId)
	local giris = WHITELIST[userId]
	if not giris then return false, "none", nil end
	if giris == true or giris == "permanent" then return true, "permanent", nil end

	if type(giris) == "table" then
		local gun = PLAN_GUN[giris.plan]
		local y, m, d = tostring(giris.start):match("^(%d+)-(%d+)-(%d+)$")
		if not gun or not y then return false, "invalid", nil end

		local ok, baslangic = pcall(function()
			return DateTime.fromUniversalTime(tonumber(y), tonumber(m), tonumber(d)).UnixTimestamp
		end)
		if not ok then return false, "invalid", nil end

		local simdi = workspace:GetServerTimeNow() -- sunucu saati (yerel saat oynamalarindan etkilenmez)
		local kalan = (baslangic + gun * 86400) - simdi
		if kalan > 0 then return true, giris.plan, kalan end
		return false, "expired", kalan
	end

	return false, "invalid", nil
end

